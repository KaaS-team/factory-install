class Factory < Formula
  desc "KaaS Factory command line"
  homepage "https://kaas.team"
  version "@@VERSION@@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "@@URL_DARWIN_ARM64@@"
      sha256 "@@SHA_DARWIN_ARM64@@"
    end
    on_intel do
      url "@@URL_DARWIN_AMD64@@"
      sha256 "@@SHA_DARWIN_AMD64@@"
    end
  end

  on_linux do
    on_arm do
      url "@@URL_LINUX_ARM64@@"
      sha256 "@@SHA_LINUX_ARM64@@"
    end
    on_intel do
      url "@@URL_LINUX_AMD64@@"
      sha256 "@@SHA_LINUX_AMD64@@"
    end
  end

  def install
    bin.install "factory"
  end

  test do
    assert_match "kaas.team", shell_output("#{bin}/factory --version")
  end
end
